{
  "name": "stellar.webdev",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "vendor": "mkdir -p public/vendor && cp node_modules/p5/lib/p5.min.js public/vendor/p5.min.js",
    "predev": "npm run vendor",
    "dev": "next dev --port 4000",
    "predev:https": "npm run vendor",
    "dev:https": "next dev --experimental-https --port 4000",
    "prebuild": "npm run vendor",
    "build": "next build",
    "serve": "npx serve out",
    "lint": "eslint ."
  },
  "dependencies": {
    "next": "^16.3.5",
    "p5": "^1.11.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "sass": "^1.104.1"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
